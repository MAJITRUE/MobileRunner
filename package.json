{
  "name": "native-runner",
  "displayName": "%displayName%",
  "description": "%description%",
  "version": "0.4.0",
  "publisher": "majitrue",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/MAJITRUE/MobileRunner"
  },
  "icon": "images/icon.png",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other",
    "Debuggers"
  ],
  "keywords": [
    "android",
    "ios",
    "xcode",
    "emulator",
    "simulator",
    "adb",
    "gradle",
    "device"
  ],
  "activationEvents": [
    "workspaceContains:**/build.gradle",
    "workspaceContains:**/build.gradle.kts",
    "workspaceContains:**/AndroidManifest.xml",
    "workspaceContains:**/*.xcodeproj",
    "workspaceContains:**/*.xcworkspace"
  ],
  "l10n": "./l10n",
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "native-runner.selectDevice",
        "title": "%command.selectDevice%"
      },
      {
        "command": "native-runner.run",
        "title": "%command.run%"
      },
      {
        "command": "native-runner.stop",
        "title": "%command.stop%"
      },
      {
        "command": "native-runner.installAndRun",
        "title": "%command.installAndRun%"
      },
      {
        "command": "native-runner.filterLog",
        "title": "%command.filterLog%"
      },
      {
        "command": "native-runner.selectVariant",
        "title": "%command.selectVariant%"
      }
    ],
    "debuggers": [
      {
        "type": "native-runner",
        "label": "Native Build & Run",
        "configurationAttributes": {
          "launch": {
            "properties": {}
          }
        }
      }
    ],
    "configuration": {
      "title": "Native Runner",
      "properties": {
        "native-runner.sdkPath": {
          "type": "string",
          "default": "",
          "description": "%config.sdkPath.description%"
        },
        "native-runner.javaHome": {
          "type": "string",
          "default": "",
          "description": "%config.javaHome.description%"
        },
        "native-runner.appModule": {
          "type": "string",
          "default": "app",
          "description": "%config.appModule.description%"
        },
        "native-runner.buildVariant": {
          "type": "string",
          "default": "debug",
          "description": "%config.buildVariant.description%"
        },
        "native-runner.autoSelectDevice": {
          "type": "boolean",
          "default": true,
          "description": "%config.autoSelectDevice.description%"
        },
        "native-runner.iosScheme": {
          "type": "string",
          "default": "",
          "description": "%config.iosScheme.description%"
        },
        "native-runner.iosConfiguration": {
          "type": "string",
          "default": "Debug",
          "description": "%config.iosConfiguration.description%"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "lint": "eslint src --ext ts"
  },
  "devDependencies": {
    "@types/vscode": "^1.85.0",
    "@types/node": "^20.0.0",
    "typescript": "^5.3.0",
    "eslint": "^8.56.0",
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0"
  }
}
